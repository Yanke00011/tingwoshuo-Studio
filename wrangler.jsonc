{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tingwoshuo-studio",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "production",
    "ACCESS_TEAM": "yankezhang",
    "ACCESS_AUD": "a2cd87067ebcd07d7727e72da15ae6fce3b0810914b5c5e14cceb95e5dbd46f7",
    "GITHUB_OWNER": "Yanke00011",
    "GITHUB_REPO": "tingwoshuo.github.io",
    "GITHUB_BASE_BRANCH": "main"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tingwoshuo-studio-production",
      "database_id": "6e67b37c-3041-4fd7-b832-eb0fffe2e9c7",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRIVATE_MEDIA",
      "bucket_name": "tingwoshuo-studio-private"
    }
  ]
}
